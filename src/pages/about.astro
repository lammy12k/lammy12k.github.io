---
import Layout from '../layouts/layout.astro';
---

<Layout title="About // lammy12k">
  <main class="relative z-10 w-full overflow-x-hidden min-h-[calc(100vh-80px)] flex flex-col justify-center items-center px-6 py-20">
    
    <canvas 
      id="interactive-bg" 
      class="fixed inset-0 pointer-events-auto z-0 w-full h-full"
    ></canvas>

    <section class="relative z-10 max-w-2xl w-full bg-[#1c1c1c]/90 backdrop-blur-md p-8 border border-neutral-800/80 shadow-2xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-3 h-3 bg-lime animate-pulse"></span>
        <span class="text-xs font-bold text-lime tracking-widest font-mono">SYS_INFO // ABOUT</span>
      </div>

      <h1 class="text-fluid-3xl font-extrabold text-white tracking-tight leading-none mb-6">
        Hi, I'm <span class="text-lime">lammy12k</span>.
      </h1>

      <div class="space-y-4 text-neutral-300 leading-relaxed font-normal text-fluid-base">
        <p>
          I'm an ambitious systems software engineer who excels in mathematics, algorithm optimization, and low-level development. I love tackling complex logic and turning mathematical concepts into fast, efficient code.
        </p>
        <p>
          Outside of programming, my favorite color is <span class="text-coral font-bold">red</span>, I'm a massive fan of hot noodles, and I enjoy listening to music while tinkering with side projects and developer tools.
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-neutral-800/80 flex flex-wrap gap-2">
        <span class="text-xs font-mono bg-[#121212] px-3 py-1.5 border border-neutral-800 text-neutral-300">C++23</span>
        <span class="text-xs font-mono bg-[#121212] px-3 py-1.5 border border-neutral-800 text-neutral-300">JAVA</span>
        <span class="text-xs font-mono bg-[#121212] px-3 py-1.5 border border-neutral-800 text-neutral-300">RUST</span>
      </div>
    </section>

  </main>
</Layout>

<script>
  function setupInteractiveBackground() {
    const canvas = document.getElementById('interactive-bg') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const mouse = { x: -1000, y: -1000, radius: 150 };

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      color: string;
    }

    const particles: Particle[] = [];
    const particleCount = Math.floor((width * height) / 12000);

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.8,
        vy: (Math.random() - 0.5) * 0.8,
        size: Math.random() * 2 + 1,
        color: Math.random() > 0.85 ? '#bbff69' : Math.random() > 0.7 ? '#f75a4f' : '#333333'
      });
    }

    window.addEventListener('click', (e) => {
      particles.forEach((p) => {
        const dx = p.x - e.clientX;
        const dy = p.y - e.clientY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 200) {
          const force = (200 - dist) / 10;
          p.vx += (dx / dist) * force;
          p.vy += (dy / dist) * force;
        }
      });
    });

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        p.x += p.vx;
        p.y += p.vy;

        p.vx *= 0.98;
        p.vy *= 0.98;

        if (Math.abs(p.vx) < 0.2) p.vx += (Math.random() - 0.5) * 0.1;
        if (Math.abs(p.vy) < 0.2) p.vy += (Math.random() - 0.5) * 0.1;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < mouse.radius) {
          const force = (mouse.radius - dist) / mouse.radius;
          p.x += (dx / dist) * force * 3;
          p.y += (dy / dist) * force * 3;
        }

        ctx.fillStyle = p.color;
        ctx.fillRect(p.x, p.y, p.size, p.size);

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const ndx = p.x - p2.x;
          const ndy = p.y - p2.y;
          const nDist = Math.sqrt(ndx * ndx + ndy * ndy);

          if (nDist < 100) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(80, 80, 80, ${1 - nDist / 100})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(animate);
    }

    animate();
  }

  setupInteractiveBackground();
</script>