---
import Layout from '../layouts/layout.astro';

interface Project {
  id: string;
  name: string;
  lang: string;
  address: string;
  status: string;
  desc: string;
  features: string[];
  source?: string;
}

const projects: Project[] = [
  {
    id: "javlates",
    name: "JavLates",
    lang: "Java",
    address: "0x7FFF001A",
    status: "ACTIVE",
    desc: "A compile-time template metaprogramming framework for Java. Brings C++ style non-type parameters, template specialization, and compile-time recursion to the Java ecosystem.",
    features: [
      "Zero-overhead runtime execution",
      "Compile-time type evaluation",
      "C++ template metaprogramming semantics"
    ],
    source: "https://github.com/lammy12k/JavLates"
  },
  {
    id: "chfe",
    name: "CHFE",
    lang: "C++",
    address: "0x7FFF009F",
    status: "STABLE",
    desc: "Lightweight, high-performance CMake tool for embedding binary files directly into executables with zero code changes and no temporary files.",
    features: [
      "Cross-platform support (Windows & Linux)",
      "Native CMake toolchain integration",
      "Zero temporary disk writes during compilation"
    ],
    source: "https://github.com/Lovent-Labs/CHFE"
  }
];
---

<Layout title="Projects // lammy12k">
  <main class="relative z-10 w-full min-h-[calc(100vh-80px)] px-6 py-12 flex flex-col justify-center items-center">
    
    <canvas 
      id="grid-wave-bg" 
      class="fixed inset-0 pointer-events-auto z-0 w-full h-full"
    ></canvas>

    <div class="max-w-5xl w-full relative z-10">
      
      <div class="flex items-center gap-3 mb-6">
        <span class="w-3 h-3 bg-lime animate-pulse"></span>
        <span class="text-xs font-bold text-lime tracking-widest font-mono">SYS_EXPLORER // VIRTUAL_FS</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 border border-neutral-800 bg-[#121212]/90 backdrop-blur-md shadow-2xl">
        
        <div class="md:col-span-5 border-b md:border-b-0 md:border-r border-neutral-800 p-6 bg-[#161616]/90">
          <div class="text-xs font-mono text-neutral-500 mb-4 pb-2 border-b border-neutral-800 flex justify-between">
            <span>PROJECT_INDEX</span>
            <span>LS_LA</span>
          </div>

          <div class="space-y-2 font-mono text-sm">
            {projects.map((proj) => (
              <button
                data-project-id={proj.id}
                class="project-tab w-full text-left p-3 border border-neutral-800 bg-[#121212] hover:border-lime/60 transition-all flex items-center justify-between group"
              >
                <div class="flex items-center gap-3">
                  <span class="text-lime font-bold group-hover:translate-x-1 transition-transform">>&nbsp;</span>
                  <span class="text-white font-bold group-hover:text-lime transition-colors">{proj.name}</span>
                </div>
                <span class="text-xs px-2 py-0.5 border border-neutral-700 bg-neutral-800 text-neutral-300">
                  .{proj.lang.toLowerCase()}
                </span>
              </button>
            ))}
          </div>

          <div class="mt-8 p-4 border border-neutral-800/80 bg-[#121212] text-xs font-mono text-neutral-500">
            <p>> Select an allocation node to inspect its runtime signature and architecture layout.</p>
          </div>
        </div>

        <div class="md:col-span-7 p-6 flex flex-col justify-between bg-[#121212]/90">
          <div>
            <div class="flex items-center justify-between border-b border-neutral-800 pb-4 mb-6 text-xs font-mono">
              <div class="flex items-center gap-2">
                <span class="text-neutral-500">PTR:</span>
                <span id="inspect-address" class="text-coral font-bold">0x00000000</span>
              </div>
              <div class="flex items-center gap-2">
                <span id="inspect-status" class="px-2 py-0.5 text-[10px] font-bold bg-lime/10 text-lime border border-lime/30">STATUS</span>
              </div>
            </div>

            <h2 id="inspect-name" class="text-2xl font-extrabold text-white tracking-wide mb-2">
              Select a project
            </h2>

            <p id="inspect-desc" class="text-neutral-400 text-sm leading-relaxed mb-6 font-normal">
              Click any node on the left file system panel to view details.
            </p>

            <div class="mb-6">
              <span class="text-xs font-mono font-bold text-neutral-500 tracking-wider block mb-3">// ARCHITECTURE_NOTES</span>
              <ul id="inspect-features" class="space-y-2 text-sm font-mono text-neutral-300">
              </ul>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800 flex items-center justify-between">
            <span id="inspect-lang" class="text-xs font-mono font-bold text-lime"></span>
            <div id="inspect-action">
            </div>
          </div>

        </div>

      </div>

    </div>

  </main>
</Layout>

<script>
  const projectsData = [
    {
      id: "javlates",
      name: "JavLates",
      lang: "Java",
      address: "0x7FFF001A",
      status: "ACTIVE",
      desc: "A compile-time template metaprogramming framework for Java. Brings C++ style non-type parameters, template specialization, and compile-time recursion to the Java ecosystem.",
      features: [
        "Zero-overhead runtime execution",
        "Compile-time type evaluation",
        "C++ template metaprogramming semantics"
      ],
      source: "https://github.com/lammy12k/JavLates"
    },
    {
      id: "chfe",
      name: "CHFE",
      lang: "C++",
      address: "0x7FFF009F",
      status: "STABLE",
      desc: "Lightweight, high-performance CMake tool for embedding binary files directly into executables with zero code changes and no temporary files.",
      features: [
        "Cross-platform support (Windows & Linux)",
        "Native CMake toolchain integration",
        "Zero temporary disk writes during compilation"
      ],
      source: "https://github.com/Lovent-Labs/CHFE"
    }
  ];

  function setupProjectInspector() {
    const tabs = document.querySelectorAll('.project-tab');
    const elAddress = document.getElementById('inspect-address');
    const elStatus = document.getElementById('inspect-status');
    const elName = document.getElementById('inspect-name');
    const elDesc = document.getElementById('inspect-desc');
    const elFeatures = document.getElementById('inspect-features');
    const elLang = document.getElementById('inspect-lang');
    const elAction = document.getElementById('inspect-action');

    function selectProject(id: string) {
      const data = projectsData.find(p => p.id === id);
      if (!data) return;

      tabs.forEach(tab => {
        const btn = tab as HTMLButtonElement;
        if (btn.dataset.projectId === id) {
          btn.classList.add('border-lime', 'bg-lime/5');
          btn.classList.remove('border-neutral-800', 'bg-[#121212]');
        } else {
          btn.classList.remove('border-lime', 'bg-lime/5');
          btn.classList.add('border-neutral-800', 'bg-[#121212]');
        }
      });

      if (elAddress) elAddress.textContent = data.address;
      if (elStatus) elStatus.textContent = data.status;
      if (elName) elName.textContent = data.name;
      if (elDesc) elDesc.textContent = data.desc;
      if (elLang) elLang.textContent = `[ ${data.lang.toUpperCase()} ]`;

      if (elFeatures) {
        elFeatures.innerHTML = data.features
          .map(feat => `<li class="flex items-center gap-2"><span class="text-lime">#</span> ${feat}</li>`)
          .join('');
      }

      if (elAction) {
        if (data.source) {
          elAction.innerHTML = `
            <a href="${data.source}" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-coral text-primary font-bold text-xs tracking-wider hover:bg-opacity-90 transition-all flex items-center gap-2">
              <span>VIEW SOURCE</span>
              <span>→</span>
            </a>
          `;
        } else {
          elAction.innerHTML = `<span class="text-xs font-mono text-neutral-600">PRIVATE_SOURCE</span>`;
        }
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const id = (tab as HTMLButtonElement).dataset.projectId;
        if (id) selectProject(id);
      });
    });

    if (projectsData.length > 0) {
      selectProject(projectsData[0].id);
    }
  }

  function setupGridWaveBackground() {
    const canvas = document.getElementById('grid-wave-bg') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const mouse = { x: -1000, y: -1000 };

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    const spacing = 40;
    let time = 0;

    function animate() {
      if (!ctx) return;
      ctx.fillStyle = '#0a0a0a';
      ctx.fillRect(0, 0, width, height);

      time += 0.02;

      for (let x = 0; x < width; x += spacing) {
        for (let y = 0; y < height; y += spacing) {
          const dx = x - mouse.x;
          const dy = y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          const wave = Math.sin(dist * 0.03 - time) * 8;
          const proximity = Math.max(0, 1 - dist / 250);

          const dotSize = 1.5 + proximity * 3;
          
          ctx.beginPath();
          ctx.arc(x, y + wave, dotSize, 0, Math.PI * 2);

          if (proximity > 0.4) {
            ctx.fillStyle = '#bbff69'; // Lime highlight near cursor
          } else if (proximity > 0.1) {
            ctx.fillStyle = '#f75a4f'; // Coral highlight mid-distance
          } else {
            ctx.fillStyle = 'rgba(60, 60, 60, 0.4)'; // Faded neutral grid default
          }

          ctx.fill();
        }
      }

      requestAnimationFrame(animate);
    }

    animate();
  }

  setupProjectInspector();
  setupGridWaveBackground();
</script>